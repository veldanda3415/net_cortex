{
  "catalog_version": "1.0",
  "signals": {
    "error_rate": {
      "signal_type": "metric", "domain": "metrics", "unit": "percent",
      "description": "Interface/service error rate in percent of packets or requests.",
      "rule": {
        "type": "zscore_baseline", "threshold": 3.0,
        "baseline_keys": ["switch=label:switch", "interface=label:interface", "uplink=label:uplink", "dst_prefix=label:dst_prefix", "core=label:core", "lag=label:lag", "service=label:service", "region=region"],
        "fallback": {"type": "threshold", "op": "gt", "value": 2.0, "reason": "legacy-threshold"}
      }
    },
    "packet_loss": {
      "signal_type": "metric", "domain": "metrics", "unit": "percent",
      "description": "Packet loss in percent.",
      "rule": {
        "type": "zscore_baseline", "threshold": 3.0,
        "baseline_keys": ["switch=label:switch", "interface=label:interface", "uplink=label:uplink", "dst_prefix=label:dst_prefix", "core=label:core", "lag=label:lag", "service=label:service", "region=region"],
        "fallback": {"type": "threshold", "op": "gt", "value": 2.0, "reason": "legacy-threshold"}
      }
    },
    "throughput_gbps": {
      "signal_type": "metric", "domain": "metrics", "unit": "Gbps",
      "description": "Delivered throughput in Gbps; a drop indicates capacity loss or congestion.",
      "rule": {
        "type": "zscore_baseline", "threshold": 3.0,
        "baseline_keys": ["switch=label:switch", "interface=label:interface", "uplink=label:uplink", "dst_prefix=label:dst_prefix", "core=label:core", "lag=label:lag", "service=label:service", "region=region"],
        "fallback": {"type": "threshold", "op": "lt", "value": 0.7, "reason": "legacy-threshold"}
      }
    },
    "latency_ms": {
      "signal_type": "metric", "domain": "metrics", "unit": "ms",
      "description": "Round-trip or request latency in milliseconds (context only, no rule)."
    },
    "TunnelState": {
      "signal_type": "metric", "domain": "metrics", "unit": "None", "entity_types": ["tunnel"],
      "description": "AWS/VPN TunnelState: 1 when the IPsec tunnel is up, 0 when down.",
      "rule": {"type": "state_equals", "value": 0, "reason": "tunnel down (TunnelState=0)"}
    },
    "TunnelDataIn": {
      "signal_type": "metric", "domain": "metrics", "unit": "Bytes", "entity_types": ["tunnel"],
      "description": "AWS/VPN bytes received through the tunnel; a collapse vs its recent level indicates traffic loss.",
      "rule": {"type": "rate_change", "direction": "decrease", "factor": 10, "min_reference": 1000, "reference": "median"}
    },
    "TunnelDataOut": {
      "signal_type": "metric", "domain": "metrics", "unit": "Bytes", "entity_types": ["tunnel"],
      "description": "AWS/VPN bytes sent through the tunnel; a collapse vs its recent level indicates traffic loss.",
      "rule": {"type": "rate_change", "direction": "decrease", "factor": 10, "min_reference": 1000, "reference": "median"}
    },
    "BytesIn": {
      "signal_type": "metric", "domain": "metrics", "unit": "Bytes", "entity_types": ["tgw_attachment"],
      "description": "AWS/TransitGateway bytes received per attachment (context only)."
    },
    "PacketDropCountBlackhole": {
      "signal_type": "metric", "domain": "metrics", "unit": "Count", "entity_types": ["tgw_attachment", "transit_gateway"],
      "description": "AWS/TransitGateway packets dropped because they matched a blackhole route.",
      "rule": {"type": "threshold", "op": "gt", "value": 0, "reason": "TGW blackhole drops"}
    },
    "PacketDropCountNoRoute": {
      "signal_type": "metric", "domain": "metrics", "unit": "Count", "entity_types": ["tgw_attachment", "transit_gateway"],
      "description": "AWS/TransitGateway packets dropped because no route matched the destination.",
      "rule": {"type": "threshold", "op": "gt", "value": 0, "reason": "TGW no-route drops"}
    },
    "BgpPeerState": {
      "signal_type": "metric", "domain": "metrics", "unit": "None", "entity_types": ["bgp_neighbor"],
      "description": "Customer-gateway router BGP session to an AWS neighbor: 1 when Established, 0 otherwise.",
      "rule": {"type": "state_equals", "value": 0, "reason": "BGP session not Established (BgpPeerState=0)"}
    },
    "PrefixesSent": {
      "signal_type": "metric", "domain": "metrics", "unit": "Count", "entity_types": ["bgp_neighbor"],
      "description": "Prefixes the customer-gateway router advertises to an AWS BGP neighbor; 0 means AWS learns no on-prem routes from it.",
      "rule": {"type": "state_equals", "value": 0, "reason": "router advertises no prefixes (PrefixesSent=0)"}
    },
    "UnHealthyHostCount": {
      "signal_type": "metric", "domain": "metrics", "unit": "Count", "entity_types": ["target_group"],
      "description": "AWS/NetworkELB targets failing health checks in a target group.",
      "rule": {"type": "threshold", "op": "gt", "value": 0, "reason": "load balancer targets unhealthy"}
    },
    "SuccessRate": {
      "signal_type": "metric", "domain": "metrics", "unit": "Percent", "entity_types": ["flow"],
      "description": "Synthetic probe success rate for one client-to-service flow (100 when healthy).",
      "rule": {"type": "threshold", "op": "lt", "value": 95, "reason": "synthetic flow failing (SuccessRate<95%)"}
    },
    "CPUUtilization": {
      "signal_type": "metric", "domain": "metrics", "unit": "Percent", "entity_types": ["instance"],
      "description": "AWS/EC2 instance CPU utilization.",
      "rule": {"type": "threshold", "op": "gt", "value": 90, "reason": "instance CPU saturated (>90%)"}
    },
    "ErrorPortAllocation": {
      "signal_type": "metric", "domain": "metrics", "unit": "Count", "entity_types": ["nat_gateway"],
      "description": "AWS/NATGateway connections that failed because no source port was free.",
      "rule": {"type": "threshold", "op": "gt", "value": 0, "reason": "NAT gateway port allocation errors"}
    },
    "PacketsDropCount": {
      "signal_type": "metric", "domain": "metrics", "unit": "Count", "entity_types": ["nat_gateway"],
      "description": "AWS/NATGateway packets dropped by the NAT gateway.",
      "rule": {"type": "threshold", "op": "gt", "value": 0, "reason": "NAT gateway dropping packets"}
    },
    "LatencyMs": {
      "signal_type": "metric", "domain": "metrics", "unit": "Milliseconds", "entity_types": ["flow"],
      "description": "Synthetic probe round-trip latency for one client-to-service flow.",
      "rule": {
        "type": "zscore_baseline", "threshold": 3.0, "baseline_keys": ["flow=entity_id"],
        "fallback": {"type": "threshold", "op": "gt", "value": 100, "reason": "flow latency above 100 ms"}
      }
    },
    "LossPercent": {
      "signal_type": "metric", "domain": "metrics", "unit": "Percent", "entity_types": ["flow"],
      "description": "Synthetic probe packet loss for one client-to-service flow.",
      "rule": {
        "type": "zscore_baseline", "threshold": 3.0, "baseline_keys": ["flow=entity_id"],
        "fallback": {"type": "threshold", "op": "gt", "value": 2, "reason": "flow packet loss above 2%"}
      }
    },
    "mem_used_percent": {
      "signal_type": "metric", "domain": "metrics", "unit": "Percent", "entity_types": ["instance"],
      "description": "CloudWatch agent (CWAgent) memory in use on an instance.",
      "rule": {"type": "threshold", "op": "gt", "value": 90, "reason": "instance memory nearly exhausted (>90%)"}
    },
    "swap_used_percent": {
      "signal_type": "metric", "domain": "metrics", "unit": "Percent", "entity_types": ["instance"],
      "description": "CloudWatch agent (CWAgent) swap in use on an instance; sustained swapping stalls packet processing.",
      "rule": {"type": "threshold", "op": "gt", "value": 50, "reason": "instance swapping heavily (>50% swap used)"}
    },
    "link_out_bps": {
      "signal_type": "metric", "domain": "metrics", "unit": "Bits/Second", "entity_types": ["tunnel", "interface"],
      "match_names": ["link_in_bps"],
      "description": "Traffic on a link in bits per second; judged against the link's capacity (labels.capacity_bps from topology or config).",
      "rule": {"type": "threshold", "op": "gt", "value": 0.8, "per": "labels.capacity_bps", "reason": "link above 80% of capacity"}
    },

    "log_message": {
      "signal_type": "event", "domain": "log",
      "description": "Application/network log line; ERROR and FATAL lines are anomalous.",
      "rule": {"type": "event_presence", "min_severity": "error"}
    },
    "frr_log": {
      "signal_type": "event", "domain": "log", "entity_types": ["bgp_neighbor"],
      "match_names": ["bgp_hold_timer_expired", "bgp_neighbor_down", "bgp_neighbor_up", "bgp_open_error", "bgpd_log"],
      "description": "FRR bgpd log line from a customer-gateway router; error severity means a BGP session failed.",
      "rule": {"type": "event_presence", "names": ["frr_log", "bgp_hold_timer_expired", "bgp_neighbor_down", "bgp_open_error", "bgpd_log"], "min_severity": "error"}
    },
    "ike_negotiation_failed": {
      "signal_type": "event", "domain": "log", "entity_types": ["ike_connection"],
      "description": "Customer-gateway IKE daemon (strongSwan charon) failed to negotiate a tunnel: no proposal chosen, retransmits exhausted or authentication failed.",
      "rule": {"type": "event_presence", "min_severity": "error"}
    },
    "vpn_tunnel_ike_down": {
      "signal_type": "metric", "domain": "log", "unit": "Count", "entity_types": ["tunnel"],
      "description": "AWS Site-to-Site VPN tunnel activity log lines per minute reporting IKE phase 1 or phase 2 down.",
      "rule": {"type": "threshold", "op": "gt", "value": 0, "reason": "AWS VPN reports IKE down"}
    },
    "vpn_bgp_prefix_limit": {
      "signal_type": "event", "domain": "log", "entity_types": ["tunnel"],
      "description": "AWS Site-to-Site VPN BGP log: AWS dropped the session because the customer gateway advertised more prefixes than the limit (1,000 for a TGW VPN).",
      "rule": {"type": "event_presence", "min_severity": "error"}
    },
    "vpn_bgp_status_down": {
      "signal_type": "event", "domain": "log", "entity_types": ["tunnel"],
      "description": "AWS Site-to-Site VPN BGP log: the AWS-side BGP session went DOWN (details say why, e.g. hold timer or prefix limit).",
      "rule": {"type": "event_presence", "min_severity": "error"}
    },
    "flow_rejects": {
      "signal_type": "metric", "domain": "log", "unit": "Count", "entity_types": ["eni"],
      "description": "VPC Flow Log REJECT records per minute on one network interface (security group or network ACL denials).",
      "rule": {"type": "threshold", "op": "gt", "value": 10, "reason": "flow log REJECT spike (>10/min)"}
    },
    "dns_nxdomain": {
      "signal_type": "metric", "domain": "log", "unit": "Count", "entity_types": ["dns_name"],
      "description": "Route 53 Resolver NXDOMAIN answers per minute for one query name in a zone this network owns.",
      "rule": {"type": "threshold", "op": "gt", "value": 0, "reason": "NXDOMAIN for a name in an owned zone (resolvers cache negative answers, so even one per minute matters)"}
    },
    "fw_invalid_drop": {
      "signal_type": "metric", "domain": "log", "unit": "Count", "entity_types": ["instance"],
      "description": "Firewall drops per minute of packets conntrack marks INVALID, typical of asymmetric routing through stateful firewalls.",
      "rule": {"type": "threshold", "op": "gt", "value": 5, "reason": "firewall INVALID-state drops (>5/min)"}
    },

    "routing_change": {
      "signal_type": "event", "domain": "routing",
      "description": "Routing change event (reroute, flap, congestion, BGP update) on a path.",
      "rule": {"type": "event_presence", "min_severity": "debug"}
    },
    "tgw_route": {
      "signal_type": "state", "domain": "routing", "entity_types": ["tgw_route_table"],
      "description": "Transit Gateway route state from SearchTransitGatewayRoutes; 'blackhole' means traffic to the CIDR is dropped.",
      "rule": {"type": "state_equals", "field": "attributes.state", "value": "blackhole", "reason": "TGW route blackhole"}
    },
    "tgw_route_uninstalled": {
      "signal_type": "event", "domain": "routing", "entity_types": ["tgw_route_table"],
      "description": "Network Manager TGW-ROUTE-UNINSTALLED: a route disappeared from a Transit Gateway route table.",
      "rule": {"type": "event_presence", "min_severity": "warning"}
    },
    "tgw_route_blackholed": {
      "signal_type": "event", "domain": "routing", "entity_types": ["tgw_route_table"],
      "description": "Network Manager routing update that leaves a Transit Gateway route in blackhole state.",
      "rule": {"type": "event_presence", "min_severity": "warning"}
    },
    "vpn_ipsec_down": {
      "signal_type": "event", "domain": "routing", "entity_types": ["tunnel"],
      "description": "Network Manager VPN-CONNECTION-IPSEC-DOWN: IPsec on one VPN tunnel went down.",
      "rule": {"type": "event_presence", "min_severity": "error"}
    },
    "vpn_bgp_down": {
      "signal_type": "event", "domain": "routing", "entity_types": ["tunnel"],
      "description": "Network Manager VPN-CONNECTION-BGP-DOWN: BGP on one VPN tunnel went down.",
      "rule": {"type": "event_presence", "min_severity": "error"}
    },

    "config_change": {
      "signal_type": "event", "domain": "config", "entity_types": ["component"],
      "description": "Configuration change record (policy update, deployment, bandwidth limit, rollback).",
      "rule": {"type": "event_presence", "min_severity": "debug"}
    },
    "change_count": {
      "signal_type": "metric", "domain": "config", "derived": true,
      "description": "Number of incident-relevant config changes per component in the window.",
      "rule": {"type": "zscore_baseline", "threshold": 2.5, "baseline_keys": ["component=entity_id", "region=region"]}
    },
    "cloudtrail_network_mutation": {
      "signal_type": "event", "domain": "config", "entity_types": ["security_group", "network_acl", "route_table", "tgw_route_table", "vpn_connection", "tgw_attachment", "instance", "hosted_zone", "target_group"],
      "match_names": [
        "RevokeSecurityGroupIngress", "RevokeSecurityGroupEgress", "AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress",
        "ReplaceRoute", "DeleteRoute", "CreateRoute", "ReplaceRouteTableAssociation",
        "ReplaceNetworkAclEntry", "DeleteNetworkAclEntry", "CreateNetworkAclEntry",
        "ModifyVpnTunnelOptions", "ModifyVpnConnection", "DeleteVpnConnection",
        "ReplaceTransitGatewayRoute", "DeleteTransitGatewayRoute", "CreateTransitGatewayRoute",
        "DisassociateTransitGatewayRouteTable", "DisableTransitGatewayRouteTablePropagation",
        "ModifyTransitGatewayVpcAttachment", "DeleteTransitGatewayVpcAttachment",
        "ModifySecurityGroupRules", "EnableTransitGatewayRouteTablePropagation", "AssociateTransitGatewayRouteTable",
        "DeleteVpcPeeringConnection", "ModifyNetworkInterfaceAttribute", "ModifyInstanceAttribute",
        "StopInstances", "TerminateInstances", "ChangeResourceRecordSets",
        "DeregisterTargets", "ModifyTargetGroup", "ModifyListener", "DeleteListener"
      ],
      "description": "CloudTrail write call that changes network reachability (security groups, NACLs, routes, VPN, TGW, DNS records, load balancers, or stops a network appliance instance).",
      "rule": {
        "type": "event_presence", "min_severity": "info",
        "names": [
          "RevokeSecurityGroupIngress", "RevokeSecurityGroupEgress", "AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress",
          "ReplaceRoute", "DeleteRoute", "CreateRoute", "ReplaceRouteTableAssociation",
          "ReplaceNetworkAclEntry", "DeleteNetworkAclEntry", "CreateNetworkAclEntry",
          "ModifyVpnTunnelOptions", "ModifyVpnConnection", "DeleteVpnConnection",
          "ReplaceTransitGatewayRoute", "DeleteTransitGatewayRoute", "CreateTransitGatewayRoute",
          "DisassociateTransitGatewayRouteTable", "DisableTransitGatewayRouteTablePropagation",
          "ModifyTransitGatewayVpcAttachment", "DeleteTransitGatewayVpcAttachment",
          "ModifySecurityGroupRules", "EnableTransitGatewayRouteTablePropagation", "AssociateTransitGatewayRouteTable",
          "DeleteVpcPeeringConnection", "ModifyNetworkInterfaceAttribute", "ModifyInstanceAttribute",
          "StopInstances", "TerminateInstances", "ChangeResourceRecordSets",
          "DeregisterTargets", "ModifyTargetGroup", "ModifyListener", "DeleteListener"
        ]
      }
    },
    "cloudtrail_read_only": {
      "signal_type": "event", "domain": "config",
      "match_names": [
        "DescribeVpnConnections", "DescribeRouteTables", "DescribeSecurityGroups", "DescribeNetworkAcls",
        "DescribeTransitGateways", "DescribeTransitGatewayRouteTables", "DescribeTransitGatewayAttachments",
        "DescribeInstances", "DescribeNetworkInterfaces", "DescribeSubnets", "DescribeVpcs",
        "GetTransitGatewayRouteTableAssociations", "GetTransitGatewayRouteTablePropagations",
        "SearchTransitGatewayRoutes", "LookupEvents", "GetMetricData"
      ],
      "description": "Routine read-only CloudTrail API call (background noise, never anomalous)."
    }
  }
}
