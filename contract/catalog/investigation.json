{
  "catalog_version": "1.0",
  "probes": {
    "tunnel": ["metrics", "log", "routing"],
    "vpn_connection": ["config", "routing"],
    "tgw_attachment": ["config", "routing", "metrics"],
    "tgw_route_table": ["config", "routing"],
    "transit_gateway": ["metrics", "routing"],
    "vpc": ["config"],
    "subnet": ["config"],
    "route_table": ["config"],
    "security_group": ["config"],
    "network_acl": ["config"],
    "eni": ["log", "config"],
    "instance": ["metrics", "log", "config"],
    "vpc_peering": ["config"],
    "bgp_neighbor": ["metrics", "log"],
    "ike_connection": ["log"],
    "nat_gateway": ["metrics", "config"],
    "load_balancer": ["config"],
    "target_group": ["metrics", "config"],
    "hosted_zone": ["config"],
    "dns_name": ["log"],
    "flow": ["metrics"]
  },
  "signal_roles": {
    "CPUUtilization": "cause",
    "ChangeResourceRecordSets": "cause",
    "CreateNetworkAclEntry": "cause",
    "CreateTransitGatewayRoute": "cause",
    "DeleteRoute": "cause",
    "DisableTransitGatewayRouteTablePropagation": "cause",
    "LatencyMs": "symptom",
    "LossPercent": "symptom",
    "ModifySecurityGroupRules": "cause",
    "ModifyTransitGatewayVpcAttachment": "cause",
    "ModifyVpnTunnelOptions": "cause",
    "PacketDropCountBlackhole": "symptom",
    "PacketDropCountNoRoute": "symptom",
    "PrefixesSent": "cause",
    "ReplaceNetworkAclEntry": "cause",
    "StopInstances": "cause",
    "SuccessRate": "symptom",
    "TunnelDataIn": "symptom",
    "TunnelDataOut": "symptom",
    "UnHealthyHostCount": "symptom",
    "bgp_hold_timer_expired": "symptom",
    "bgp_open_error": "cause",
    "cloudtrail_network_mutation": "cause",
    "config_change": "cause",
    "dns_nxdomain": "symptom",
    "flow_rejects": "symptom",
    "fw_invalid_drop": "symptom",
    "ike_negotiation_failed": "cause",
    "tgw_route": "cause",
    "tgw_route_blackholed": "cause",
    "tgw_route_uninstalled": "symptom",
    "vpn_bgp_down": "symptom"
  },
  "role_with": {
    "PrefixesSent": {"BgpPeerState": "symptom"}
  },
  "lead_patterns": {
    "\\btgw-rtb-[0-9a-f]{8,17}\\b": "tgw_route_table",
    "\\btgw-attach-[0-9a-f]{8,17}\\b": "tgw_attachment",
    "\\btgw-[0-9a-f]{8,17}\\b": "transit_gateway",
    "\\brtb-[0-9a-f]{8,17}\\b": "route_table",
    "\\bnat-[0-9a-f]{8,17}\\b": "nat_gateway",
    "\\bsg-[0-9a-f]{8,17}\\b": "security_group",
    "\\bacl-[0-9a-f]{8,17}\\b": "network_acl",
    "\\beni-[0-9a-f]{8,17}\\b": "eni",
    "\\bi-[0-9a-f]{8,17}\\b": "instance",
    "\\bpcx-[0-9a-f]{8,17}\\b": "vpc_peering",
    "\\bvpn-[0-9a-f]{8,17}\\b": "vpn_connection",
    "\\bvpc-[0-9a-f]{8,17}\\b": "vpc",
    "\\bsubnet-[0-9a-f]{8,17}\\b": "subnet"
  },
  "walk": {"max_hops": 5, "lookback_minutes": 15, "max_requests_per_round": 12},
  "rank_weights": {"evidence": 1.0, "topology": 1.0, "precedence": 1.0, "role": 1.5}
}
