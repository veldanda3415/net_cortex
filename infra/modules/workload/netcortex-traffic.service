[Unit]
Description=NetCortex lab traffic agent (synthetic flows -> CloudWatch metrics)
# Not ordered after netcortex-workload: that unit starts this one from inside its
# own ExecStart, so such an ordering deadlocks the first boot.
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/netcortex-traffic /etc/netcortex/workload.json
Restart=always
RestartSec=10
DynamicUser=yes

[Install]
WantedBy=multi-user.target
